# PostgreSQL connection. Railway and Render often provide postgres:// or postgresql://.
# The app rewrites those to postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://stt:stt@localhost:5432/speech

# Free key from https://aistudio.google.com/apikey
# Leave empty to use the browser speech engine (Chrome or Edge).
GEMINI_API_KEY=

# Documented live transcription model. Override if Google renames it.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live

PORT=8000
